---
// Temporary shell: the interactive island for this page lands with the server work.
import BaseLayout from '@aw/ui/layout/BaseLayout.astro';
import { pageContext } from '@aw/ui/context';

interface Props {
  titleKey: string;
  path: string;
}
const { titleKey, path } = Astro.props;
const ctx = pageContext(Astro.url);
const title = ctx.tr(titleKey as 'cart.title');
---
<BaseLayout ctx={ctx} meta={{ title, description: '', path, noindex: true }} hideFab>
  <div class="container-page py-10">
    <h1 class="text-h1 mb-4">{title}</h1>
    <slot />
  </div>
</BaseLayout>
