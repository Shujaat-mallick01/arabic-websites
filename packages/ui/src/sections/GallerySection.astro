---
// Gallery / lookbook: a 9:16 rail (lookbook) or a grid (gallery). Lightbox is native: each image
// links to its full-size file so it works without JS.
import { Picture, getImage } from 'astro:assets';
import SectionHeader from './SectionHeader.astro';
import type { PageContext } from '../context.ts';
import type { Raw } from '../data.ts';
import { bi } from '@aw/content';

interface Props {
  ctx: PageContext;
  section: Raw;
  items: Array<{ id: string; entry: { ar: Raw; en: Raw } }>;
  variant?: 'rail' | 'grid' | 'wall';
  link?: string;
  heading?: string;
}
const { ctx, section: s, items, variant = 'rail', link, heading } = Astro.props;
const limit = Number(s.limit ?? 9);
const list = items.slice(0, limit).map((g) => ({ id: g.id, image: g.entry.ar.image, caption: bi(g.entry as never, 'caption'), alt: bi(g.entry as never, 'alt') }));
const full = await Promise.all(list.map((g) => (g.image ? getImage({ src: g.image, width: 1400, format: 'webp' }) : null)));
---
{list.length > 0 && (
  <section class="section-gap" aria-labelledby={`g-${variant}`}>
    <div class="container-page">
      <SectionHeader id={`g-${variant}`} title={heading ?? ctx.pick(s.title)} subtitle={ctx.pick(s.subtitle)} link={link ? { label: ctx.tr('viewAll'), href: ctx.href(link) } : undefined} />
      {variant === 'rail' ? (
        <ul class="scroll-rail m-0 p-0 list-none gap-3 md:gap-5 -mx-[var(--brand-gutter)] px-[var(--brand-gutter)]">
          {list.map((g, i) => (
            <li class="w-[58%] md:w-[22%]">
              <a href={full[i]?.src} class="block overflow-hidden rounded-card aspect-[9/16] bg-surface" aria-label={ctx.pick(g.alt) || ctx.pick(g.caption)}>
                {g.image && <Picture src={g.image} alt={ctx.pick(g.alt) || ctx.pick(g.caption)} formats={['avif', 'webp']} fallbackFormat="webp" widths={[240, 480]} sizes="(min-width: 768px) 22vw, 58vw" loading="lazy" class="h-full w-full object-cover" />}
              </a>
              {ctx.pick(g.caption) && <p class="m-0 mt-2 text-small text-muted">{ctx.pick(g.caption)}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <ul class:list={['m-0 p-0 list-none grid', variant === 'wall' ? 'grid-cols-3 gap-0.5' : 'grid-cols-2 md:grid-cols-3 gap-3 md:gap-5']}>
          {list.map((g, i) => (
            <li>
              <a href={full[i]?.src} class:list={['block overflow-hidden bg-surface', variant === 'wall' ? 'aspect-square' : 'aspect-[3/4] rounded-image']} aria-label={ctx.pick(g.alt) || ctx.pick(g.caption)}>
                {g.image && <Picture src={g.image} alt={ctx.pick(g.alt) || ctx.pick(g.caption)} formats={['avif', 'webp']} fallbackFormat="webp" widths={[240, 480, 720]} sizes="(min-width: 768px) 33vw, 50vw" loading="lazy" class="h-full w-full object-cover" />}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
)}
