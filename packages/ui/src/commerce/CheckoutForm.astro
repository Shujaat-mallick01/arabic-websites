---
// One-page guest checkout: contact → delivery → payment, with a live server quote in the summary.
// Fields are real inputs; the island only collects them, asks /api/quote and submits /api/checkout.
import { COUNTRY_INFO } from '@aw/core';
import { ADDRESS_FIELDS, SHIPPING_FIELDS } from '@aw/i18n';
import { availableMethods, METHOD_LABELS } from '@aw/payments';
import Icon from '../primitives/Icon.astro';
import type { PageContext } from '../context.ts';
import { getCheckoutRules, getFulfilment, getPages } from '../data.ts';

interface Props {
  ctx: PageContext;
}
const { ctx } = Astro.props;
const rules = await getFulfilment();
const checkout = await getCheckoutRules();
const pages = await getPages(ctx.lang);
const terms = pages.find((p) => p.slug === 'terms');
const zones = rules.delivery?.zones.filter((z) => z.active) ?? [];
const countries = rules.shipping?.countries.filter((c) => c.active) ?? [];
const branches = rules.pickup?.branches ?? [];
const p = ctx.site.payments!;
const methods = availableMethods(ctx.site.locale.currency, p.provider ?? null, p.methods);
const home = ctx.site.locale.country;
const localFields = ADDRESS_FIELDS[home];
const modes = [
  ...(zones.length ? [{ id: 'delivery', label: ctx.tr('checkout.delivery'), icon: 'truck' as const }] : []),
  ...(countries.length ? [{ id: 'shipping', label: ctx.tr('checkout.shipping'), icon: 'globe' as const }] : []),
  ...(branches.length ? [{ id: 'pickup', label: ctx.tr('checkout.pickup'), icon: 'store' as const }] : []),
];
const dial = COUNTRY_INFO[home].dialCode;
const zoneKind = zones[0]?.kind ?? 'area';
const zoneLabel = zoneKind === 'governorate' || zoneKind === 'province' ? (ctx.lang === 'ar' ? 'المحافظة' : 'Governorate') : zoneKind === 'district' ? (ctx.lang === 'ar' ? 'الحي' : 'District') : ctx.tr('checkout.zone');
const field = (f: (typeof localFields)[number], prefix: string) => ({ id: `${prefix}-${f.id}`, name: `address.${f.id}` });
---
<aw-checkout class="block container-page py-6 md:py-10" data-primary={p.primary}>
  <h1 class="text-h1 mb-6">{ctx.tr('checkout.title')}</h1>
  <form novalidate class="grid gap-8 md:grid-cols-12 md:gap-12" aria-label={ctx.tr('checkout.title')}>
    <div class="md:col-span-7 min-w-0 flex flex-col gap-8">
      <div data-errors class="hidden p-4 rounded-control border-2 border-danger" role="alert" tabindex="-1">
        <p class="m-0 mb-2" data-errors-title></p>
        <ul class="m-0 ps-5 text-small" data-errors-list></ul>
      </div>

      <section aria-labelledby="co-contact" class="flex flex-col gap-4">
        <h2 id="co-contact" class="text-h3">{ctx.tr('checkout.contact')}</h2>
        <div class="aw-field">
          <label class="aw-label" for="co-name">{ctx.tr('form.name')}</label>
          <input id="co-name" name="name" class="aw-input" dir="auto" autocomplete="name" required maxlength="80" aria-describedby="err-name" />
          <p class="aw-error" id="err-name" hidden></p>
        </div>
        <div class="aw-field">
          <label class="aw-label" for="co-phone">{ctx.tr('form.phone')}</label>
          <div class="flex items-stretch gap-2" dir="ltr">
            <span class="inline-flex items-center px-3 rounded-control border border-muted bg-surface tabular" data-dial>+{dial}</span>
            <input id="co-phone" name="phone" class="aw-input" type="tel" inputmode="tel" autocomplete="tel-national" dir="ltr" required aria-describedby="err-phone" />
          </div>
          <p class="aw-error" id="err-phone" hidden></p>
        </div>
        <div class="aw-field">
          <label class="aw-label" for="co-email">{ctx.tr('form.emailOptional')}</label>
          <input id="co-email" name="email" type="email" class="aw-input" dir="ltr" autocomplete="email" aria-describedby="err-email" />
          <p class="aw-error" id="err-email" hidden></p>
        </div>
      </section>

      <section aria-labelledby="co-ful" class="flex flex-col gap-4">
        <h2 id="co-ful" class="text-h3">{ctx.tr('checkout.fulfilment')}</h2>
        {modes.length > 1 && (
          <div class="flex flex-wrap gap-2" role="radiogroup" aria-labelledby="co-ful">
            {modes.map((m, i) => (
              <label class="aw-chip gap-2">
                <input type="radio" name="mode" value={m.id} checked={i === 0} />
                <Icon name={m.icon} size={20} />
                <span>{m.label}</span>
              </label>
            ))}
          </div>
        )}
        {modes.length === 1 && <input type="hidden" name="mode" value={modes[0]!.id} />}

        {zones.length > 0 && (
          <div class="flex flex-col gap-4" data-mode-panel="delivery">
            <div class="aw-field">
              <label class="aw-label" for="co-zone">{zoneLabel}</label>
              <select id="co-zone" name="zoneId" class="aw-select">
                {zones.map((z) => <option value={z.id}>{ctx.pick(z.name)}</option>)}
              </select>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              {localFields.map((f) => (
                <div class:list={['aw-field', f.id === 'landmark' && 'sm:col-span-2']}>
                  <label class="aw-label" for={field(f, 'loc').id}>{ctx.pick(f.label)} {!f.required && <span class="text-muted font-normal">{ctx.tr('form.optional')}</span>}</label>
                  <input id={field(f, 'loc').id} name={field(f, 'loc').name} class="aw-input" dir="auto" maxlength={f.maxLength} inputmode={f.inputmode} autocomplete={f.autocomplete} required={f.required} aria-describedby={`err-address.${f.id}`} />
                  {f.hint && <p class="aw-hint">{ctx.pick(f.hint)}</p>}
                  <p class="aw-error" id={`err-address.${f.id}`} hidden></p>
                </div>
              ))}
            </div>
          </div>
        )}

        {countries.length > 0 && (
          <div class="flex flex-col gap-4" data-mode-panel="shipping" hidden>
            <div class="aw-field">
              <label class="aw-label" for="co-country">{ctx.tr('checkout.country')}</label>
              <select id="co-country" name="country" class="aw-select">
                {countries.map((c) => <option value={c.code} data-dial={COUNTRY_INFO[c.code].dialCode}>{ctx.pick(COUNTRY_INFO[c.code].name)}</option>)}
              </select>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              {SHIPPING_FIELDS.map((f) => (
                <div class:list={['aw-field', f.id === 'line1' && 'sm:col-span-2']}>
                  <label class="aw-label" for={field(f, 'shp').id}>{ctx.pick(f.label)} {!f.required && <span class="text-muted font-normal">{ctx.tr('form.optional')}</span>}</label>
                  <input id={field(f, 'shp').id} name={`ship.${f.id}`} class="aw-input" dir="auto" maxlength={f.maxLength} autocomplete={f.autocomplete} required={f.required} />
                </div>
              ))}
            </div>
            {rules.shipping?.dutiesNote && <p class="aw-hint">{ctx.pick(rules.shipping.dutiesNote)}</p>}
          </div>
        )}

        {branches.length > 0 && (
          <div class="flex flex-col gap-4" data-mode-panel="pickup" hidden>
            <div class="aw-field">
              <label class="aw-label" for="co-branch">{ctx.tr('checkout.branch')}</label>
              <select id="co-branch" name="branchId" class="aw-select">
                {branches.map((b) => <option value={b.id}>{ctx.pick(b.name)}</option>)}
              </select>
            </div>
            {rules.pickup && <p class="aw-hint">{ctx.lang === 'ar' ? `جاهز للاستلام بعد ${ctx.num(rules.pickup.readyInHours)} ساعات، ونحفظه ${ctx.num(rules.pickup.holdDays)} أيام.` : `Ready ${rules.pickup.readyInHours} hours after ordering; held for ${rules.pickup.holdDays} days.`}</p>}
          </div>
        )}
        <p class="aw-error" id="err-fulfilment" hidden></p>
      </section>

      <section aria-labelledby="co-pay" class="flex flex-col gap-3">
        <h2 id="co-pay" class="text-h3">{ctx.tr('checkout.payment')}</h2>
        <label class="flex items-start gap-3 p-4 rounded-card border border-muted cursor-pointer has-[:checked]:border-ink has-[:checked]:border-2">
          <input type="radio" name="payment" value="online" class="mt-1 w-5 h-5" checked={p.primary !== 'cod'} />
          <span class="flex flex-col gap-2">
            <span style="font-weight: var(--brand-fw-ui)">{ctx.tr('checkout.payOnline')}</span>
            <span class="flex flex-wrap gap-1.5">{methods.map((m) => <span class="px-2 py-0.5 rounded-control border border-line text-small">{METHOD_LABELS[m][ctx.lang]}</span>)}</span>
          </span>
        </label>
        {p.cod && (
          <label class="flex items-start gap-3 p-4 rounded-card border border-muted cursor-pointer has-[:checked]:border-ink has-[:checked]:border-2" data-cod>
            <input type="radio" name="payment" value="cod" class="mt-1 w-5 h-5" checked={p.primary === 'cod'} />
            <span class="flex flex-col gap-1">
              <span style="font-weight: var(--brand-fw-ui)">{ctx.tr('checkout.cod')}</span>
              <span class="text-small text-muted">{ctx.tr('checkout.codHint')}</span>
              <span class="text-small text-danger" data-cod-off hidden>{ctx.lang === 'ar' ? 'الدفع عند الاستلام غير متاح لهذا الطلب.' : 'Cash on delivery is not available for this order.'}</span>
            </span>
          </label>
        )}
      </section>

      <section class="flex flex-col gap-4" aria-label={ctx.tr('checkout.notes')}>
        {checkout.giftWrap && (
          <label class="flex items-center gap-3 min-h-11">
            <input type="checkbox" name="giftWrap" class="w-5 h-5" />
            <span>{ctx.tr('product.giftWrap')} (+<bdi class="price">{ctx.money(checkout.giftWrap.price)}</bdi>)</span>
          </label>
        )}
        {checkout.giftWrap && (
          <div class="aw-field" data-gift-message hidden>
            <label class="aw-label" for="co-gift">{ctx.tr('product.cardMessage')}</label>
            <textarea id="co-gift" name="giftMessage" class="aw-textarea" dir="auto" maxlength={checkout.giftWrap.cardMaxLength} rows="2"></textarea>
          </div>
        )}
        {ctx.has('giftCards') && (
          <div class="aw-field">
            <label class="aw-label" for="co-gc">{ctx.tr('checkout.giftCard')} <span class="text-muted font-normal">{ctx.tr('form.optional')}</span></label>
            <div class="flex gap-2">
              <input id="co-gc" name="giftCardCode" class="aw-input uppercase" dir="ltr" autocomplete="off" aria-describedby="err-giftCard" />
              <button type="button" class="aw-btn aw-btn-secondary" data-apply-gc>{ctx.tr('checkout.giftCardApply')}</button>
            </div>
            <p class="aw-error" id="err-giftCard" hidden></p>
          </div>
        )}
        <div class="aw-field">
          <label class="aw-label" for="co-notes">{ctx.tr('checkout.notes')} <span class="text-muted font-normal">{ctx.tr('form.optional')}</span></label>
          <textarea id="co-notes" name="notes" class="aw-textarea" dir="auto" maxlength={checkout.notesMaxLength} rows="2"></textarea>
        </div>
        <div class="visually-hidden" aria-hidden="true"><label>Company website<input name="company_website" tabindex="-1" autocomplete="off" /></label></div>
      </section>
    </div>

    <aside class="md:col-span-5">
      <div class="md:sticky md:top-24 flex flex-col gap-4 p-5 md:p-6 rounded-card bg-surface">
        <h2 class="text-h3">{ctx.tr('checkout.summary')}</h2>
        <ul class="m-0 p-0 list-none flex flex-col gap-3" data-lines></ul>
        <dl class="m-0 grid grid-cols-[1fr_auto] gap-x-4 gap-y-2 text-body border-t border-line pt-4" data-totals aria-live="polite"></dl>
        <p class="m-0 text-small text-muted" data-vat></p>
        <p class="m-0 text-small text-accent" data-gap></p>
        <button type="submit" class="aw-btn aw-btn-primary aw-btn-block" data-submit>{ctx.tr('checkout.placeOrder')}</button>
        {terms && <p class="m-0 text-small text-muted" set:html={ctx.tr('checkout.terms', { link: `<a class="aw-link" href="${ctx.href(`/policies/${terms.slug}/`)}">${ctx.tr('checkout.termsLink')}</a>` })} />}
        <p class="m-0 text-small text-muted" data-empty hidden>{ctx.tr('cart.empty')}</p>
      </div>
    </aside>
  </form>
</aw-checkout>

<script>
  import { readCart, clearCart } from '../client/cart.ts';
  import { escapeHtml, money, siteBlob, str } from '../client/runtime.ts';
  import { track } from '../client/analytics.ts';
  import type { Money } from '@aw/core';

  type Q = { ok: boolean; subtotal: Money; shipping: Money; codFee: Money | null; giftWrap: Money | null; giftCard: { applied?: Money; invalid?: boolean } | null; vatIncluded: Money | null; total: Money; payable: Money; freeShippingGap: Money | null; codOffered: boolean };

  class AwCheckout extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector('form')!;
      const s = siteBlob();
      const started = Date.now();
      const lines = readCart();
      const linesEl = this.querySelector<HTMLElement>('[data-lines]')!;
      const totals = this.querySelector<HTMLElement>('[data-totals]')!;
      const submit = this.querySelector<HTMLButtonElement>('[data-submit]')!;
      if (!lines.length) {
        this.querySelector<HTMLElement>('[data-empty]')!.hidden = false;
        submit.disabled = true;
      }
      linesEl.innerHTML = lines
        .map((l) => `<li class="flex justify-between gap-3 text-small"><span>${escapeHtml(l.title[s.lang] || l.title.ar)} × ${l.qty}${l.labels.length ? `<br><span class="text-muted">${l.labels.map((x) => escapeHtml(x.value[s.lang] || x.value.ar)).join(' · ')}</span>` : ''}</span><span class="price">${money(l.total)}</span></li>`)
        .join('');

      const mode = () => (form.querySelector<HTMLInputElement>('[name="mode"]:checked') ?? form.querySelector<HTMLInputElement>('[name="mode"]'))?.value ?? 'delivery';
      const panels = () => {
        const m = mode();
        this.querySelectorAll<HTMLElement>('[data-mode-panel]').forEach((p) => {
          p.hidden = p.dataset.modePanel !== m;
          p.querySelectorAll<HTMLInputElement>('input,select').forEach((i) => (i.disabled = p.hidden));
        });
        const dial = m === 'shipping' ? form.querySelector<HTMLSelectElement>('[name="country"]')?.selectedOptions[0]?.dataset.dial : null;
        const el = this.querySelector('[data-dial]');
        if (el && dial) el.textContent = `+${dial}`;
        else if (el) el.textContent = el.textContent ?? '';
      };
      const wrapMsg = this.querySelector<HTMLElement>('[data-gift-message]');
      const body = () => {
        const fd = new FormData(form);
        const m = mode();
        const fulfilment = m === 'delivery' ? { kind: 'delivery', zoneId: fd.get('zoneId') } : m === 'shipping' ? { kind: 'shipping', country: fd.get('country') } : { kind: 'pickup', branchId: fd.get('branchId') };
        const address: Record<string, string> = {};
        for (const [k, v] of fd) {
          if (m === 'delivery' && k.startsWith('address.')) address[k.slice(8)] = String(v);
          if (m === 'shipping' && k.startsWith('ship.')) address[k.slice(5)] = String(v);
        }
        const phone = String(fd.get('phone') ?? '').trim();
        const dial = this.querySelector('[data-dial]')?.textContent ?? '';
        return {
          lang: s.lang,
          lines: readCart().map((l) => ({ productId: l.productId, selection: l.selection, qty: l.qty, ...(l.addons ? { addons: l.addons } : {}) })),
          fulfilment,
          address,
          customer: { name: fd.get('name'), phone: phone.startsWith('+') || phone.startsWith('00') ? phone : `${dial}${phone.replace(/^0/, '')}`, email: fd.get('email') || undefined },
          payment: fd.get('payment') ?? 'online',
          giftWrap: !!fd.get('giftWrap'),
          giftMessage: fd.get('giftMessage') || undefined,
          giftCardCode: String(fd.get('giftCardCode') ?? '').trim() || undefined,
          notes: fd.get('notes') || undefined,
          company_website: fd.get('company_website') || undefined,
          startedAt: started,
        };
      };
      const row = (label: string, value: string, strong = false) => `<dt class="${strong ? 'font-bold' : 'text-muted'}">${escapeHtml(label)}</dt><dd class="m-0 price ${strong ? 'font-bold' : ''}">${value}</dd>`;
      let timer = 0;
      const quote = async () => {
        if (!lines.length) return;
        try {
          const res = await fetch('/api/quote', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body()) });
          const q = (await res.json()) as Q;
          totals.innerHTML =
            row(str('cart.subtotal'), money(q.subtotal)) +
            row(str('checkout.shippingFee'), q.shipping.minor === 0 ? str('checkout.free') : money(q.shipping)) +
            (q.codFee ? row(str('checkout.codFee'), money(q.codFee)) : '') +
            (q.giftWrap ? row(str('checkout.giftWrapFee'), money(q.giftWrap)) : '') +
            (q.giftCard?.applied ? row(str('checkout.giftCard'), `−${money(q.giftCard.applied)}`) : '') +
            row(str('checkout.total'), money(q.payable), true);
          this.querySelector('[data-vat]')!.textContent = q.vatIncluded ? str('checkout.vatIncluded', { amount: money(q.vatIncluded) }) : '';
          this.querySelector('[data-gap]')!.textContent = q.freeShippingGap ? str('cart.freeShippingLeft', { amount: money(q.freeShippingGap) }) : '';
          const cod = form.querySelector<HTMLInputElement>('[name="payment"][value="cod"]');
          if (cod) {
            cod.disabled = !q.codOffered;
            this.querySelector<HTMLElement>('[data-cod-off]')!.hidden = q.codOffered;
            if (!q.codOffered && cod.checked) form.querySelector<HTMLInputElement>('[name="payment"][value="online"]')!.checked = true;
          }
          const gcErr = this.querySelector<HTMLElement>('#err-giftCard');
          if (gcErr) {
            gcErr.hidden = !q.giftCard?.invalid;
            gcErr.textContent = q.giftCard?.invalid ? (s.lang === 'ar' ? 'رمز البطاقة غير صحيح أو منتهي.' : 'That code is invalid or expired.') : '';
          }
          submit.textContent = q.payable.minor === 0 || (new FormData(form).get('payment') === 'cod') ? str('checkout.placeOrder') : `${str('checkout.payNow')} · ${money(q.payable)}`;
        } catch {
          totals.innerHTML = '';
        }
      };
      const requote = () => {
        clearTimeout(timer);
        timer = window.setTimeout(quote, 250);
      };
      form.addEventListener('change', (e) => {
        const t = e.target as HTMLInputElement;
        if (t.name === 'mode' || t.name === 'country') panels();
        if (t.name === 'giftWrap' && wrapMsg) wrapMsg.hidden = !t.checked;
        if (['mode', 'zoneId', 'country', 'branchId', 'payment', 'giftWrap'].includes(t.name)) requote();
      });
      this.querySelector('[data-apply-gc]')?.addEventListener('click', quote);
      panels();
      quote();
      track({ name: 'begin_checkout', props: { value: String(lines.reduce((n, l) => n + l.total.minor, 0)), currency: s.currency, items: lines.length } });

      const box = this.querySelector<HTMLElement>('[data-errors]')!;
      const showErrors = (errs: Array<{ field: string; message: string }>) => {
        this.querySelectorAll<HTMLElement>('.aw-error').forEach((e) => (e.hidden = true));
        this.querySelectorAll('[aria-invalid]').forEach((e) => e.removeAttribute('aria-invalid'));
        if (!errs.length) return box.classList.add('hidden');
        this.querySelector('[data-errors-title]')!.textContent = errs.length === 1 ? str('form.errorSummaryOne') : str('form.errorSummary', { n: errs.length });
        const list = this.querySelector('[data-errors-list]')!;
        list.innerHTML = '';
        for (const e of errs) {
          const li = document.createElement('li');
          li.textContent = e.message;
          list.append(li);
          const el = this.querySelector<HTMLElement>(`[id="err-${e.field}"]`);
          if (el) {
            el.textContent = e.message;
            el.hidden = false;
          }
          const input = form.querySelector(`[name="${e.field === 'name' || e.field === 'phone' || e.field === 'email' ? e.field : e.field}"]`);
          input?.setAttribute('aria-invalid', 'true');
        }
        box.classList.remove('hidden');
        box.focus();
      };
      const issueText = (body: { lineIssues?: unknown[][]; fulfilmentIssues?: Array<{ code: string }>; orderIssues?: Array<{ code: string }> }) => {
        const out: Array<{ field: string; message: string }> = [];
        if (body.lineIssues?.some((x) => x.length)) out.push({ field: 'cart', message: s.lang === 'ar' ? 'بعض القطع في السلة تحتاج اختيار المقاس أو اللون. ارجع لصفحة المنتج.' : 'Some items need a size or colour. Go back to the product page.' });
        for (const f of body.fulfilmentIssues ?? []) out.push({ field: 'fulfilment', message: s.lang === 'ar' ? 'خيار التوصيل غير متاح. اختر منطقة أو تاريخاً آخر.' : 'That delivery option is unavailable. Choose another area or date.' });
        for (const o of body.orderIssues ?? []) if (o.code === 'min_order') out.push({ field: 'cart', message: s.lang === 'ar' ? 'المجموع أقل من الحد الأدنى للطلب.' : 'The total is below the minimum order.' });
        return out;
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        submit.disabled = true;
        const label = submit.textContent;
        submit.textContent = str('checkout.processing');
        try {
          const res = await fetch('/api/checkout', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body()) });
          const out = await res.json().catch(() => ({ error: `http_${res.status}` }));
          if (res.ok && out.redirectUrl) {
            track({ name: 'purchase', props: { orderId: out.orderId, value: '', currency: s.currency, method: String(new FormData(form).get('payment')) } });
            clearCart();
            location.href = out.redirectUrl;
            return;
          }
          const known = [...(out.errors ?? []), ...issueText(out)];
          showErrors(known.length ? known : [{ field: 'form', message: out.error === 'too_fast' ? str('form.err.tooFast') : str('form.err.generic') }]);
        } catch {
          showErrors([{ field: 'form', message: str('form.err.network') }]);
        }
        submit.disabled = false;
        submit.textContent = label;
      });
    }
  }
  if (!customElements.get('aw-checkout')) customElements.define('aw-checkout', AwCheckout);
</script>
