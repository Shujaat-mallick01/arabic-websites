---
// A grid or a horizontal rail of products, chosen by the owner's filter in settings/home.json.
import { compare, parseDecimal } from '@aw/core';
import type { Product } from '@aw/commerce';
import ProductCard from '../commerce/ProductCard.astro';
import Rail from '../primitives/Rail.astro';
import SectionHeader from './SectionHeader.astro';
import type { PageContext } from '../context.ts';
import type { Category, Img, Raw } from '../data.ts';

interface Props {
  ctx: PageContext;
  section: Raw;
  products: Product<Img>[];
  categories?: Category[];
  layout?: 'grid' | 'rail';
  id?: string;
  band?: boolean;
}

const { ctx, section: s, products, categories = [], layout = 'grid', id, band = false } = Astro.props;
const limit = Number(s.limit ?? 8);
const filter = s.filter ?? 'featured';
let items = products.filter((p) => p.availability !== 'sold_out' || filter === 'tag');
if (filter === 'featured') items = items.filter((p) => p.featured);
if (filter === 'new') items = items.filter((p) => p.tags.includes('new')).concat(items.filter((p) => !p.tags.includes('new')));
if (filter === 'tag' && s.value) items = items.filter((p) => p.tags.includes(String(s.value)));
if (filter === 'category' && s.value) items = items.filter((p) => p.category === s.value);
if (filter === 'under' && s.value) {
  const cap = parseDecimal(String(s.value), ctx.site.locale.currency);
  items = items.filter((p) => compare(p.price, cap) <= 0);
}
items = items.slice(0, limit);
const link = s.ctaHref && ctx.pick(s.ctaLabel) ? { label: ctx.pick(s.ctaLabel), href: ctx.href(s.ctaHref) } : filter === 'category' && s.value ? { label: ctx.tr('viewAll'), href: ctx.href(`/shop/${s.value}/`) } : { label: ctx.tr('viewAll'), href: ctx.href('/shop/') };
const catName = new Map(categories.map((c) => [c.id, ctx.pick(c.title)]));
const cols = ctx.site.layout.grid === 'one-col-large' ? 'grid-cols-1 md:grid-cols-2' : 'grid-cols-2 lg:grid-cols-4';
const useBand = band || s.band === true;
---
{items.length > 0 && (
  <section class:list={[useBand ? 'aw-band py-14 md:py-20' : 'section-gap']} aria-labelledby={id}>
    <div class="container-page">
      <SectionHeader id={id} eyebrow={ctx.pick(s.eyebrow)} title={ctx.pick(s.title)} subtitle={ctx.pick(s.subtitle)} link={link} />
      {layout === 'rail' ? (
        <Rail label={ctx.pick(s.title)}>
          {items.map((p) => (
            <li class="w-[46%] sm:w-[31%] md:w-[calc((100%-3*1.25rem)/4)]"><ProductCard ctx={ctx} product={p} categoryLabel={catName.get(p.category)} sizes="(min-width: 768px) 23vw, 46vw" /></li>
          ))}
        </Rail>
      ) : (
        <ul class:list={['m-0 p-0 list-none grid gap-x-3 gap-y-9 md:gap-x-6 md:gap-y-12', cols]}>
          {items.map((p, i) => <li><ProductCard ctx={ctx} product={p} categoryLabel={catName.get(p.category)} eager={i < 2} /></li>)}
        </ul>
      )}
    </div>
  </section>
)}
