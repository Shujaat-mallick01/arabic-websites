---
// Signature "arrival-ribbon" (site 02): "يوصلج الكويت بين السبت 26 والأحد 27 سبتمبر".
// Computed in the browser in the site's zone from the dispatch cutoff and each country's transit
// days, because static HTML would go stale. The chosen country is remembered across pages.
import { COUNTRY_INFO, GCC_COUNTRIES, type GccCountry } from '@aw/core';
import type { PageContext } from '../context.ts';
import { getSettings } from '../data.ts';

interface Props {
  ctx: PageContext;
  where: 'product' | 'card' | 'cart' | 'home';
  hemming?: boolean;
}
const { ctx, where, hemming = false } = Astro.props;
const f = await getSettings('fulfilment');
const home = ctx.site.locale.country as GccCountry;
const zones = (f.delivery?.zones ?? []) as Array<Record<string, any>>;
const homeEta = zones.length ? { min: Math.min(...zones.map((z) => Number(z.etaMin ?? 1))), max: Math.max(...zones.map((z) => Number(z.etaMax ?? 2))) } : { min: 1, max: 2 };
const countries = [
  { code: home, eta: homeEta, days: f.delivery?.deliveryDays ?? ['sat', 'sun', 'mon', 'tue', 'wed', 'thu'] },
  ...((f.shipping?.countries ?? []) as Array<Record<string, any>>)
    .filter((c) => c.active !== false && GCC_COUNTRIES.includes(c.code))
    .map((c) => ({ code: c.code as GccCountry, eta: { min: Number(c.etaMin ?? 2), max: Number(c.etaMax ?? 5) }, days: c.deliveryDays?.length ? c.deliveryDays : ['sat', 'sun', 'mon', 'tue', 'wed', 'thu'] })),
];
const cfg = {
  tz: ctx.site.locale.timeZone,
  dispatchDays: f.delivery?.deliveryDays ?? ['sat', 'sun', 'mon', 'tue', 'wed', 'thu'],
  cutoff: f.delivery?.dispatchCutoff ?? '13:00',
  blackouts: f.delivery?.blackouts ?? [],
  countries,
  home,
};
const verb = ctx.lang === 'ar' ? (ctx.site.locale.audience === 'women' ? 'يوصلج' : 'يوصلك') : 'Arrives in';
const range = (min: number, max: number) => (ctx.lang === 'ar' ? `خلال ${ctx.num(min)}–${ctx.num(max)} أيام عمل` : `in ${min}–${max} working days`);
const card = where === 'card';
---
<aw-arrival class:list={['block', card ? 'border-t-2 border-accent pt-1 text-small text-accent' : 'bg-accent text-accent-ink rounded-control px-4 py-3 min-h-10']} data-hemming={hemming ? '1' : '0'}>
  <script type="application/json" set:html={JSON.stringify(cfg)}></script>
  <p class="m-0 flex flex-wrap items-center gap-x-1.5 gap-y-1">
    <span>{verb}</span>
    <label class="relative inline-flex items-center">
      <span class="visually-hidden">{ctx.tr('checkout.country')}</span>
      <select class="appearance-none bg-transparent border-0 border-b border-current text-inherit font-[inherit] pe-4 cursor-pointer min-h-8" data-country>
        {countries.map((c) => <option value={c.code} selected={c.code === home}>{ctx.pick(COUNTRY_INFO[c.code].name)}</option>)}
      </select>
      <span aria-hidden="true" class="absolute inset-e-0 pointer-events-none text-[0.7em]">▾</span>
    </label>
    <span data-when aria-live="polite">{range(homeEta.min, homeEta.max)}</span>
  </p>
  {!card && <p class="m-0 mt-1 text-small opacity-90" data-cutoff></p>}
</aw-arrival>

<script>
  import { arrivalWindow } from '@aw/commerce';
  import { zonedNow } from '@aw/core';
  import { date, siteBlob, storage } from '../client/runtime.ts';

  class AwArrival extends HTMLElement {
    connectedCallback() {
      const cfg = JSON.parse(this.querySelector('script')!.textContent || '{}');
      const select = this.querySelector<HTMLSelectElement>('[data-country]')!;
      const when = this.querySelector<HTMLElement>('[data-when]')!;
      const cutoffEl = this.querySelector<HTMLElement>('[data-cutoff]');
      const s = siteBlob();
      const region = (navigator.language.split('-')[1] ?? '').toUpperCase();
      const saved = storage.get('aw.country');
      const pick = saved && cfg.countries.some((c: { code: string }) => c.code === saved) ? saved : cfg.countries.some((c: { code: string }) => c.code === region) ? region : cfg.home;
      select.value = pick;
      const render = () => {
        const c = cfg.countries.find((x: { code: string }) => x.code === select.value) ?? cfg.countries[0];
        const w = arrivalWindow({ now: new Date(), tz: cfg.tz, dispatchDays: cfg.dispatchDays, cutoff: cfg.cutoff, transit: c.eta, deliveryDays: c.days, closed: cfg.blackouts, leadDays: 0 });
        const f = (d: string) => date(d);
        if (s.lang === 'ar') when.textContent = w.from === w.to ? f(w.from) : `بين ${f(w.from)} و${f(w.to)}`;
        else when.textContent = w.from === w.to ? f(w.from) : `${f(w.from)} – ${f(w.to)}`;
        if (cutoffEl) {
          const now = zonedNow(cfg.tz);
          const [h, m] = String(cfg.cutoff).split(':').map(Number);
          const before = now.minutes < (h! * 60 + m!) && cfg.dispatchDays.includes(now.weekday);
          const hh = String(cfg.cutoff);
          cutoffEl.textContent = before ? (s.lang === 'ar' ? `اطلبي قبل ${hh} وينشحن طلبج اليوم` : `Order before ${hh} to ship today`) : (s.lang === 'ar' ? 'ينشحن طلبج في أول يوم شحن' : 'Ships on the next dispatch day');
          if (s.audience !== 'women' && s.lang === 'ar') cutoffEl.textContent = cutoffEl.textContent.replace('اطلبي', 'اطلب').replace('طلبج', 'طلبك');
        }
      };
      select.addEventListener('change', () => {
        storage.set('aw.country', select.value);
        window.dispatchEvent(new CustomEvent('aw:country', { detail: select.value }));
        render();
      });
      // Keep every ribbon on the page in sync without re-dispatching change events.
      window.addEventListener('aw:country', (e) => {
        const code = (e as CustomEvent<string>).detail;
        if (select.value !== code) {
          select.value = code;
          render();
        }
      });
      render();
    }
  }
  if (!customElements.get('aw-arrival')) customElements.define('aw-arrival', AwArrival);
</script>
