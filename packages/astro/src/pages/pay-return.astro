---
import BaseLayout from '@aw/ui/layout/BaseLayout.astro';
import PayReturn from '@aw/ui/commerce/PayReturn.astro';
import { pageContext } from '@aw/ui/context';

const ctx = pageContext(Astro.url);
---
<BaseLayout ctx={ctx} meta={{ title: ctx.tr('pay.checking'), description: '', path: '/pay/return/', noindex: true }} hideFab>
  <PayReturn ctx={ctx} />
</BaseLayout>
