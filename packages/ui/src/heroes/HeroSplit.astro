---
// Generic split hero: photo and text side by side on desktop, stacked on phones.
import { Picture } from 'astro:assets';
import type { PageContext } from '../context.ts';
import type { Raw } from '../data.ts';

interface Props {
  ctx: PageContext;
  section: Raw;
}
const { ctx, section: s } = Astro.props;
---
<section class="pt-6 md:pt-12" aria-labelledby="hero-title">
  <div class="container-page grid gap-6 md:grid-cols-12 md:items-center">
    <div class="md:col-span-5 md:order-2 flex flex-col gap-4">
      {ctx.pick(s.eyebrow) && <p class="aw-eyebrow m-0">{ctx.pick(s.eyebrow)}</p>}
      <h1 id="hero-title" class="text-display display-case" style="font-weight: var(--brand-fw-display)">{ctx.pick(s.title)}</h1>
      {ctx.pick(s.subtitle) && <p class="m-0 text-muted max-w-md">{ctx.pick(s.subtitle)}</p>}
      <div class="flex flex-wrap gap-3 mt-2">
        {s.ctaHref && ctx.pick(s.ctaLabel) && <a href={ctx.href(s.ctaHref)} class="aw-btn aw-btn-primary">{ctx.pick(s.ctaLabel)}</a>}
        {s.secondaryHref && ctx.pick(s.secondaryLabel) && <a href={ctx.href(s.secondaryHref)} class="aw-btn aw-btn-secondary">{ctx.pick(s.secondaryLabel)}</a>}
      </div>
    </div>
    <div class="md:col-span-7 overflow-hidden rounded-image bg-surface" style="aspect-ratio: var(--brand-aspect-hero)">
      {s.image && <Picture src={s.image} alt={ctx.pick(s.imageAlt)} formats={['avif', 'webp']} fallbackFormat="webp" widths={[390, 780, 1200]} sizes="(min-width: 768px) 58vw, 100vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover" />}
    </div>
  </div>
</section>
