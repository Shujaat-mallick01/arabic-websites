---
// Hero "arch-frame": the mirror-arch photo with a floating "open late" chip, and the statement
// beside it (kicker, headline with an accent phrase, text, book + menu buttons, live next free
// times and a stats row counted from the content), then the trust strip.
import { Picture } from 'astro:assets';
import ArchFrame from '../signature/ArchFrame.astro';
import NextSlots from '../booking/NextSlots.astro';
import Icon from '../primitives/Icon.astro';
import TrustStrip from '../sections/TrustStrip.astro';
import { hl } from '../primitives/hl.ts';
import type { PageContext } from '../context.ts';
import { getHours, getResources } from '../data.ts';
import { latestClose } from '../primitives/hours.ts';
import type { Category, Raw, ServiceItem } from '../data.ts';

interface Props {
  ctx: PageContext;
  section: Raw;
  categories: Category[];
  services: ServiceItem[];
}
const { ctx, section: s, services } = Astro.props;
const ar = ctx.lang === 'ar';
const featured = (services.filter((x) => x.featured).length ? services.filter((x) => x.featured) : services).slice(0, 6);
const resources = ctx.has('resources') ? await getResources() : [];
const staff = resources.filter((r) => r.kind === 'staff' && r.active).length;
const rooms = resources.filter((r) => r.kind === 'room' && r.active).length;
const late = ctx.has('hours') ? latestClose(await getHours()) : 0;
const stats = [
  { n: services.length, label: ar ? 'خدمة' : 'services' },
  ...(staff ? [{ n: staff, label: ar ? 'خبيرات' : 'stylists' }] : []),
  ...(rooms ? [{ n: rooms, label: ar ? 'غرف' : 'rooms' }] : []),
];
---
<section class="aw-glow pt-6 md:pt-14 overflow-x-clip" aria-labelledby="hero-title">
  <div class="container-page grid gap-10 md:grid-cols-12 md:gap-10 md:items-center">
    <div class="relative md:col-span-5 md:order-2 max-w-md mx-auto w-full md:max-w-none">
      <ArchFrame aspect="3 / 4">
        {s.image && <Picture src={s.image} alt={ctx.pick(s.imageAlt)} formats={['avif', 'webp']} fallbackFormat="webp" widths={[390, 716, 1000]} sizes="(min-width: 768px) 40vw, 100vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover" />}
      </ArchFrame>
      {late > 1440 && (
        <div class="absolute bottom-8 -inset-s-3 md:-inset-s-10 aw-card-elev px-4 py-3 flex items-center gap-3" aria-hidden="true">
          <span class="aw-icon-tile w-10 h-10 rounded-full"><Icon name="moon" size={20} /></span>
          <span class="flex flex-col leading-tight">
            <span class="text-small" style="font-weight: var(--brand-fw-ui)">{ar ? 'فاتحين لآخر الليل' : 'Open late'}</span>
            <span class="text-[0.78rem] text-muted">{ar ? `كل يوم لحد ${ctx.time(late)}` : `Daily until ${ctx.time(late)}`}</span>
          </span>
        </div>
      )}
    </div>
    <div class="md:col-span-7 flex flex-col gap-6">
      {ctx.pick(s.eyebrow) && <p class="aw-kicker">{ctx.pick(s.eyebrow)}</p>}
      <h1 id="hero-title" class="text-display" style="font-weight: var(--brand-fw-display)" set:html={hl(ctx.pick(s.title))} />
      {ctx.pick(s.subtitle) && <p class="m-0 text-muted max-w-xl">{ctx.pick(s.subtitle)}</p>}
      <div class="flex flex-wrap gap-3">
        <a href={ctx.href(s.ctaHref || '/book/')} class="aw-btn aw-btn-primary"><Icon name="calendar" size={18} />{ctx.pick(s.ctaLabel) || ctx.tr('cta.book')}</a>
        {s.secondaryHref && ctx.pick(s.secondaryLabel) && <a href={ctx.href(s.secondaryHref)} class="aw-btn aw-btn-secondary">{ctx.pick(s.secondaryLabel)}</a>}
      </div>
      <NextSlots />
      <aw-next-slots class="block min-h-[4.5rem] text-small text-muted" data-limit="4" data-service={featured[0]?.id}>{ar ? 'أقرب المواعيد تظهر هنا' : 'Next free times appear here'}</aw-next-slots>
      {stats.length > 0 && (
        <dl class="m-0 grid grid-cols-3 gap-3 max-w-md">
          {stats.map((x) => (
            <div class="aw-card-elev px-4 py-3 flex flex-col">
              <dt class="order-2 text-small text-muted">{x.label}</dt>
              <dd class="m-0 order-1 font-display text-h2 text-accent tabular leading-none mb-1">{ctx.num(x.n)}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </div>
</section>

<TrustStrip ctx={ctx} class="mt-12 md:mt-16" skipLate={late > 1440} />
