---
// A wide photo band with a text panel at the inline start. Nothing centred.
import { Picture } from 'astro:assets';
import type { PageContext } from '../context.ts';
import type { Raw } from '../data.ts';

interface Props {
  ctx: PageContext;
  section: Raw;
  reverse?: boolean;
}
const { ctx, section: s, reverse = false } = Astro.props;
---
<section class="section-gap">
  <div class="container-page">
    <div class="grid gap-6 md:grid-cols-12 md:items-center">
      <div class:list={['md:col-span-7 overflow-hidden rounded-image bg-surface aspect-[4/5] md:aspect-[4/3]', reverse && 'md:order-2']}>
        {s.image && <Picture src={s.image} alt={ctx.pick(s.imageAlt)} formats={['avif', 'webp']} fallbackFormat="webp" widths={[390, 780, 1100]} sizes="(min-width: 768px) 58vw, 100vw" loading="lazy" class="h-full w-full object-cover" />}
      </div>
      <div class="md:col-span-5 flex flex-col gap-4">
        {ctx.pick(s.title) && <h2 class="text-h1">{ctx.pick(s.title)}</h2>}
        {ctx.pick(s.subtitle) && <p class="m-0 text-muted">{ctx.pick(s.subtitle)}</p>}
        {ctx.pick(s.priceNote) && <p class="m-0 price">{ctx.pick(s.priceNote)}</p>}
        {s.ctaHref && ctx.pick(s.ctaLabel) && <a href={ctx.href(s.ctaHref)} class="aw-btn aw-btn-primary self-start">{ctx.pick(s.ctaLabel)}</a>}
      </div>
    </div>
  </div>
</section>
