---
// Sample reviews, always labelled "تقييم توضيحي". Never marked up as Review/AggregateRating.
// Variants: quote-rail, card-stack, single-large.
import SectionHeader from './SectionHeader.astro';
import type { PageContext } from '../context.ts';
import type { Raw } from '../data.ts';
import { bi } from '@aw/content';

interface Props {
  ctx: PageContext;
  section: Raw;
  items: Array<{ id: string; entry: { ar: Raw; en: Raw } }>;
}
const { ctx, section: s, items } = Astro.props;
const variant = (ctx.site.layout.sectionVariants.reviews ?? 'quote-rail') as 'quote-rail' | 'card-stack' | 'single-large';
const list = items.slice(0, Number(s.limit ?? 4)).map((r) => ({
  id: r.id,
  name: bi(r.entry as never, 'name'),
  city: bi(r.entry as never, 'city'),
  item: bi(r.entry as never, 'item'),
  body: bi(r.entry as never, 'body'),
}));
const sample = ctx.site.demo.enabled;
---
{list.length > 0 && (
  <section class="section-gap" aria-labelledby="reviews-title">
    <div class="container-page">
      <SectionHeader id="reviews-title" title={ctx.pick(s.title) || ctx.tr('section.reviews')} subtitle={sample ? ctx.tr('demo.reviewsNote') : ctx.pick(s.subtitle)} />
      {variant === 'single-large' ? (
        <figure class="m-0 max-w-3xl">
          <blockquote class="m-0 text-h2 font-body" style="font-weight: var(--brand-fw-body); line-height: 1.6">“{ctx.pick(list[0]!.body)}”</blockquote>
          <figcaption class="mt-4 text-muted">{ctx.pick(list[0]!.name)}{ctx.pick(list[0]!.city) && `، ${ctx.pick(list[0]!.city)}`}{sample && <span class="ms-3 text-small border border-muted rounded-control px-2 py-0.5">{ctx.tr('demo.reviewLabel')}</span>}</figcaption>
        </figure>
      ) : (
        <ul class:list={['m-0 p-0 list-none', variant === 'quote-rail' ? 'scroll-rail gap-3 md:gap-5 -mx-[var(--brand-gutter)] px-[var(--brand-gutter)]' : 'grid gap-4 md:grid-cols-2']}>
          {list.map((r) => (
            <li class:list={['flex flex-col gap-3 p-5 md:p-6 rounded-card bg-surface', variant === 'quote-rail' && 'w-[82%] md:w-[30%]']}>
              <p class="m-0 text-body">“{ctx.pick(r.body)}”</p>
              <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 text-small text-muted">
                <span>{ctx.pick(r.name)}{ctx.pick(r.city) && `، ${ctx.pick(r.city)}`}</span>
                {ctx.pick(r.item) && <span>· {ctx.pick(r.item)}</span>}
                {sample && <span class="border border-muted rounded-control px-2 py-0.5">{ctx.tr('demo.reviewLabel')}</span>}
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
)}
