# GENERATED by pnpm site:sync. Do not edit.
# Copy to .env for local testing. Set real values in Netlify (Site configuration → Environment variables).
# ── mode ────────────────────────────────────────
PAYMENTS_MODE=mock                      # mock | test | live   (unset = mock; live refuses test-looking keys)
ORDER_STORE=blobs                       # blobs | supabase | memory
OWNER_AUTH=demo                         # demo | email-otp | supabase
MAIL_PROVIDER=outbox                    # outbox | resend
# ── required for test/live ──────────────────────
SESSION_SECRET=                         # ≥ 32 random bytes, base64 (owner sessions, order view tokens)
RESEND_API_KEY=                         # Needed when MAIL_PROVIDER=resend
MAIL_FROM=                              # "Shop <orders@client-domain>" on a verified domain
MOYASAR_SECRET_KEY=                     # sk_test_… or sk_live_…
MOYASAR_WEBHOOK_SECRET_TOKEN=           # The secret token you set in Dashboard → Webhooks
# ── optional ────────────────────────────────────
MOCK_WEBHOOK_SECRET=                    # Signs demo gateway webhooks (a default is used if unset)
SUPABASE_URL=                           # Only with ORDER_STORE=supabase
SUPABASE_SERVICE_ROLE_KEY=              # Only with ORDER_STORE=supabase; server-side only
