---
import BaseLayout from '@aw/ui/layout/BaseLayout.astro';
import CheckoutForm from '@aw/ui/commerce/CheckoutForm.astro';
import { pageContext } from '@aw/ui/context';

const ctx = pageContext(Astro.url);
---
<BaseLayout ctx={ctx} meta={{ title: ctx.tr('checkout.title'), description: '', path: '/checkout/', noindex: true }} hideFab>
  <CheckoutForm ctx={ctx} />
</BaseLayout>
