---
import BaseLayout from '@aw/ui/layout/BaseLayout.astro';
import OrderView from '@aw/ui/commerce/OrderView.astro';
import { pageContext } from '@aw/ui/context';

const ctx = pageContext(Astro.url);
---
<BaseLayout ctx={ctx} meta={{ title: ctx.tr('order.title'), description: '', path: '/order/', noindex: true }} hideFab>
  <OrderView ctx={ctx} />
</BaseLayout>
