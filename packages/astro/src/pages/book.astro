---
import BaseLayout from '@aw/ui/layout/BaseLayout.astro';
import BookingFlow from '@aw/ui/booking/BookingFlow.astro';
import { pageContext } from '@aw/ui/context';

const ctx = pageContext(Astro.url);
---
<BaseLayout ctx={ctx} meta={{ title: ctx.tr('booking.title'), description: '', path: '/book/' }} hideFab>
  <BookingFlow ctx={ctx} />
</BaseLayout>
