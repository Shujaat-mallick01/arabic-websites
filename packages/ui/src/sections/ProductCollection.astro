---
// A grid or a horizontal rail of products, chosen by the owner's filter in settings/home.json.
import { compare, parseDecimal } from '@aw/core';
import type { Product } from '@aw/commerce';
import ProductCard from '../commerce/ProductCard.astro';
import SectionHeader from './SectionHeader.astro';
import type { PageContext } from '../context.ts';
import type { Img, Raw } from '../data.ts';

interface Props {
  ctx: PageContext;
  section: Raw;
  products: Product<Img>[];
  layout?: 'grid' | 'rail';
  id?: string;
}

const { ctx, section: s, products, layout = 'grid', id } = Astro.props;
const limit = Number(s.limit ?? 8);
const filter = s.filter ?? 'featured';
let items = products.filter((p) => p.availability !== 'sold_out' || filter === 'tag');
if (filter === 'featured') items = items.filter((p) => p.featured);
if (filter === 'new') items = items.filter((p) => p.tags.includes('new')).concat(items.filter((p) => !p.tags.includes('new')));
if (filter === 'tag' && s.value) items = items.filter((p) => p.tags.includes(String(s.value)));
if (filter === 'category' && s.value) items = items.filter((p) => p.category === s.value);
if (filter === 'under' && s.value) {
  const cap = parseDecimal(String(s.value), ctx.site.locale.currency);
  items = items.filter((p) => compare(p.price, cap) <= 0);
}
items = items.slice(0, limit);
const link = s.ctaHref && ctx.pick(s.ctaLabel) ? { label: ctx.pick(s.ctaLabel), href: ctx.href(s.ctaHref) } : filter === 'category' && s.value ? { label: ctx.tr('viewAll'), href: ctx.href(`/shop/${s.value}/`) } : undefined;
const cols = ctx.site.layout.grid === 'one-col-large' ? 'grid-cols-1 md:grid-cols-2' : 'grid-cols-2 lg:grid-cols-4';
---
{items.length > 0 && (
  <section class="section-gap" aria-labelledby={id}>
    <div class="container-page">
      <SectionHeader id={id} title={ctx.pick(s.title)} subtitle={ctx.pick(s.subtitle)} link={link} />
      {layout === 'rail' ? (
        <ul class="scroll-rail m-0 p-0 list-none gap-3 md:gap-5 -mx-[var(--brand-gutter)] px-[var(--brand-gutter)]">
          {items.map((p) => (
            <li class="w-[42%] md:w-[23%]"><ProductCard ctx={ctx} product={p} sizes="(min-width: 768px) 23vw, 42vw" /></li>
          ))}
        </ul>
      ) : (
        <ul class:list={['m-0 p-0 list-none grid gap-x-3 gap-y-8 md:gap-x-6 md:gap-y-12', cols]}>
          {items.map((p) => <li><ProductCard ctx={ctx} product={p} /></li>)}
        </ul>
      )}
    </div>
  </section>
)}
