---
import BaseLayout from '@aw/ui/layout/BaseLayout.astro';
import GiftCardForm from '@aw/ui/commerce/GiftCardForm.astro';
import { pageContext } from '@aw/ui/context';

const ctx = pageContext(Astro.url);
---
<BaseLayout ctx={ctx} meta={{ title: ctx.tr('nav.giftCards'), description: '', path: '/gift-cards/', noindex: false }} hideFab>
  <GiftCardForm ctx={ctx} />
</BaseLayout>
