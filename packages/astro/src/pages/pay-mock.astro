---
import BaseLayout from '@aw/ui/layout/BaseLayout.astro';
import MockGateway from '@aw/ui/commerce/MockGateway.astro';
import { pageContext } from '@aw/ui/context';

const ctx = pageContext(Astro.url);
---
<BaseLayout ctx={ctx} meta={{ title: ctx.tr('pay.mockTitle'), description: '', path: '/pay/mock/', noindex: true }} hideFab>
  <MockGateway ctx={ctx} />
</BaseLayout>
